{
  "version": 2,
  "installCommand": "npm install && npx tsx build.ts",
  "outputDirectory": ".",
  "functions": {
    "dist/index.cjs": {
      "runtime": "@vercel/node@3",
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.cjs"
    }
  ]
}
