{
  "buildCommand": "npx esbuild server/api-handler.ts --bundle --platform=node --target=node22 --outfile=api/index.cjs && next build",
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "api" },
    { "source": "/health", "destination": "api" }
  ]
}
