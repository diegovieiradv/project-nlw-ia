{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/(health|rooms.*)", "dest": "api/index.ts" },
    { "src": "/health", "dest": "api/index.ts" },
    { "src": "/rooms$", "dest": "api/index.ts" },
    { "src": "/rooms/([^/]+)$", "dest": "api/index.ts" },
    { "src": "/rooms/([^/]+)/messages$", "dest": "api/index.ts" },
    { "src": "/rooms/([^/]+)/questions$", "dest": "api/index.ts" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
