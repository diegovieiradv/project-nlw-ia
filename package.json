{
  "name": "project-nlw-ia",
  "version": "1.0.0",
  "description": "NLW IA - Backend API with Fastify, Drizzle ORM and PostgreSQL with pgvector",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --experimental-strip-types --no-warnings --watch src/server.ts",
    "start": "node --env-file=.env --experimental-strip-types --no-warnings src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "nlw",
    "ia",
    "ai",
    "fastify",
    "drizzle"
  ],
  "author": "Diego Vieira",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@google/genai": "^2.20.0",
    "@types/node": "^24.0.12",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.0.2",
    "postgres": "^3.4.7",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.1",
    "ultracite": "5.0.32"
  }
}
